; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Bloedjungle"
config/description="Top-down shooter: verdedig je jungle-bunker tegen golven vijanden."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/vsync/vsync_mode=1

[layer_names]

3d_physics/layer_1="grond"
3d_physics/layer_2="muur"
3d_physics/layer_3="speler"
3d_physics/layer_4="vijand"
3d_physics/layer_5="bunker"
3d_physics/layer_6="tank"

[rendering]

textures/default_filters/anisotropic_filtering_level=3

anti_aliasing/quality/screen_space_aa=1

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[xogot]

project/editorState=[]
project/shaderEditorState=[]
project/breakpoints={}
project/disabled_breakpoints={}
